# ===== Supabase Postgres =====
# direct host (db.<ref>.supabase.co) 는 IPv6 only 라 일반 네트워크에서 DNS 실패할 수 있음.
# Supavisor 풀러 사용 권장:
#   - Session mode (port 5432) — Spring Boot/JPA 등 persistent 연결에 사용
#   - Transaction mode (port 6543) — 단명 연결 (Lambda 등). prepared statement / listen-notify 제약
# 정확한 host 는 Supabase Dashboard > Project Settings > Database > Session/Transaction pooler 탭에서 확인.
# 접두사 aws-0 / aws-1 / aws-2 는 프로젝트 생성 시점에 따라 다름.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-<N>-<region>.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<supabase-project-ref>
SPRING_DATASOURCE_PASSWORD=<rotate-and-fill-in-local-only>

# ===== OAuth & JWT =====
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
KAKAO_CLIENT_ID=<kakao-client-id>
KAKAO_CLIENT_SECRET=<kakao-client-secret>
NAVER_CLIENT_ID=<naver-client-id>
NAVER_CLIENT_SECRET=<naver-client-secret>
JWT_SECRET=<at-least-32-byte-random-secret>
AUTH_COOKIE_NAME=WM_ACCESS_TOKEN
AUTH_COOKIE_MAX_AGE_SECONDS=3600
AUTH_COOKIE_SECURE=false

# OAuth redirect/callback URI
# Google: http://localhost:8080/login/oauth2/code/google
# Kakao:  http://localhost:8080/login/oauth2/code/kakao
# Naver:  http://localhost:8080/login/oauth2/code/naver
#
# Kakao scope
# - 기본 로그인은 profile_nickname, profile_image만 요청합니다.
# - account_email은 비즈앱 전환/동의항목 권한 설정 전에는 KOE205가 발생할 수 있어 제외했습니다.

# ===== App =====
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JPA_SHOW_SQL=false
APP_LOG_LEVEL=INFO
HIBERNATE_SQL_LOG_LEVEL=WARN
